    "Tap a host to connect. Face ID is asked for every session; the first connection shows the server's fingerprint to check." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tippe auf einen Host, um dich zu verbinden. Face ID wird bei jeder Sitzung abgefragt; die erste Verbindung zeigt den Fingerabdruck des Servers zur Prüfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a host to connect. Face ID is asked for every session; the first connection shows the server's fingerprint to check."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toca un host para conectarte. Se pide Face ID en cada sesión; la primera conexión muestra la huella del servidor para comprobarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un hôte pour vous connecter. Face ID est demandé à chaque session ; la première connexion affiche l’empreinte du serveur à vérifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tocca un host per connetterti. Face ID viene chiesto a ogni sessione; la prima connessione mostra l’impronta del server da verificare."
          }
        }
      }
    },
