    "Import only files you made yourself. Check each address: your tokens will be sent there once you enter them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Importiere nur Dateien, die du selbst erstellt hast. Prüfe jede Adresse: Deine Tokens werden dorthin gesendet, sobald du sie eingibst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import only files you made yourself. Check each address: your tokens will be sent there once you enter them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Importa solo archivos creados por ti. Comprueba cada dirección: tus tokens se enviarán allí cuando los introduzcas."
