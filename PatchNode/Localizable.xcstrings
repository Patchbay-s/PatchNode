    "What you configure stays on this iPhone: service names and addresses in the app's private storage (included in this iPhone's backups), tokens and passwords in the Keychain, for this device only." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was du einrichtest, bleibt auf diesem iPhone: Namen und Adressen der Dienste im privaten Speicher der App (Teil der Backups dieses iPhone), Tokens und Passwörter im Schlüsselbund, nur für dieses Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
