    "To edit this project and run its actions, turn on Settings › SSH and add an SSH host linked to the Docker host %@. Projects deployed by Portainer are managed through its API." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um dieses Projekt zu bearbeiten und seine Aktionen auszuführen, aktiviere Einstellungen › SSH und füge einen SSH-Host hinzu, der mit dem Docker-Host %@ verknüpft ist. Von Portainer bereitgestellte Projekte werden über seine API verwaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To edit this project and run its actions, turn on Settings › SSH and add an SSH host linked to the Docker host %@. Projects deployed by Portainer are managed through its API."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para editar este proyecto y ejecutar sus acciones, activa Ajustes › SSH y añade un host SSH vinculado al host Docker %@. Los proyectos desplegados por Portainer se gestionan a través de su API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour modifier ce projet et lancer ses actions, activez Réglages › SSH et ajoutez un hôte SSH relié à l’hôte Docker %@. Les projets déployés par Portainer sont gérés par son API."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per modificare questo progetto ed eseguirne le azioni, attiva Impostazioni › SSH e aggiungi un host SSH collegato all’host Docker %@. I progetti distribuiti da Portainer sono gestiti tramite la sua API."
          }
        }
      }
    },
