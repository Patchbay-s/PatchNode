          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo que configuras se queda en este iPhone: nombres y direcciones de los servicios en el almacenamiento privado de la app (incluido en las copias de seguridad de este iPhone), tokens y contraseñas en el llavero, solo para este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous configurez reste sur cet iPhone : noms et adresses des services dans le stockage privé de l’app (inclus dans les sauvegardes de cet iPhone), jetons et mots de passe dans le trousseau, pour cet appareil uniquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ciò che configuri resta su questo iPhone: nomi e indirizzi dei servizi nello spazio privato dell’app (incluso nei backup di questo iPhone), token e password nel portachiavi, solo per questo dispositivo."
          }
        }
      }
    },
