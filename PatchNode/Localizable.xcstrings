    },
    "The server presented another host key (%@). The connection was refused: it may be an impersonation. If you reinstalled the server, check the new fingerprint, then forget the old key in Settings › SSH." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Server hat einen anderen Host-Schlüssel vorgelegt (%@). Die Verbindung wurde abgelehnt: Es könnte ein Täuschungsversuch sein. Wenn du den Server neu installiert hast, prüfe den neuen Fingerabdruck und vergiss dann den alten Schlüssel in Einstellungen › SSH."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server presented another host key (%@). The connection was refused: it may be an impersonation. If you reinstalled the server, check the new fingerprint, then forget the old key in Settings › SSH."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El servidor presentó otra clave de host (%@). Se rechazó la conexión: puede ser una suplantación. Si reinstalaste el servidor, comprueba la nueva huella y olvida la clave anterior en Ajustes › SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a présenté une autre clé d’hôte (%@). La connexion a été refusée : il peut s’agir d’une usurpation. Si vous avez réinstallé le serveur, vérifiez la nouvelle empreinte, puis oubliez l’ancienne clé dans Réglages › SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il server ha presentato un’altra chiave dell’host (%@). La connessione è stata rifiutata: potrebbe trattarsi di un’impersonificazione. Se hai reinstallato il server, controlla la nuova impronta, poi dimentica la vecchia chiave in Impostazioni › SSH."
          }
        }
      }
    },
    "The server refused this device's key and the password." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Server hat den Schlüssel dieses Geräts und das Passwort abgelehnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused this device's key and the password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El servidor rechazó la clave de este dispositivo y la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé la clé de cet appareil et le mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il server ha rifiutato la chiave di questo dispositivo e la password."
          }
        }
      }
    },
    "The server refused this device's key. Add the authorized_keys line from Settings › SSH to the user's ~/.ssh/authorized_keys." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Server hat den Schlüssel dieses Geräts abgelehnt. Füge die authorized_keys-Zeile aus Einstellungen › SSH in ~/.ssh/authorized_keys des Benutzers ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused this device's key. Add the authorized_keys line from Settings › SSH to the user's ~/.ssh/authorized_keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El servidor rechazó la clave de este dispositivo. Añade la línea authorized_keys de Ajustes › SSH al ~/.ssh/authorized_keys del usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé la clé de cet appareil. Ajoutez la ligne authorized_keys de Réglages › SSH au ~/.ssh/authorized_keys de l’utilisateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il server ha rifiutato la chiave di questo dispositivo. Aggiungi la riga authorized_keys di Impostazioni › SSH al ~/.ssh/authorized_keys dell’utente."
          }
        }
      }
    },
    "The server refused this device's key. The password is used for this connection only and never stored." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Server hat den Schlüssel dieses Geräts abgelehnt. Das Passwort gilt nur für diese Verbindung und wird nie gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused this device's key. The password is used for this connection only and never stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El servidor rechazó la clave de este dispositivo. La contraseña solo se usa para esta conexión y nunca se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé la clé de cet appareil. Le mot de passe ne sert qu’à cette connexion et n’est jamais conservé."
          }
        },
        "it" : {
