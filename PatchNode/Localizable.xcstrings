    "HTTPS is required: put your services behind a reverse proxy with a valid certificate." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HTTPS ist Pflicht: Stelle deine Dienste hinter einen Reverse Proxy mit gültigem Zertifikat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS is required: put your services behind a reverse proxy with a valid certificate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HTTPS es obligatorio: pon tus servicios detrás de un proxy inverso con un certificado válido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS est obligatoire : placez vos services derrière un reverse proxy avec un certificat valide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HTTPS è obbligatorio: metti i tuoi servizi dietro un reverse proxy con un certificato valido."
          }
        }
      }
    },
