        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los widgets muestran los últimos datos guardados por la app. iOS decide cuándo se actualiza en segundo plano; abrir la app los actualiza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les widgets affichent les dernières données enregistrées par l’app. iOS décide quand l’actualisation en arrière-plan a lieu ; ouvrir l’app les rafraîchit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I widget mostrano gli ultimi dati salvati dall’app. iOS decide quando avviene l’aggiornamento in background; aprire l’app li aggiorna."
