    "Forced stop, like pulling the power plug: unsaved data in the guest may be lost. Prefer Shut down when possible. Target: %@ (%@)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erzwungener Stopp, wie Stecker ziehen: Nicht gespeicherte Daten im Gast können verloren gehen. Wenn möglich, lieber Herunterfahren. Ziel: %1$@ (%2$@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forced stop, like pulling the power plug: unsaved data in the guest may be lost. Prefer Shut down when possible. Target: %@ (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parada forzada, como desenchufar la corriente: pueden perderse datos no guardados del invitado. Usa Apagar si es posible. Destino: %1$@ (%2$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêt forcé, comme débrancher l’alimentation : les données non enregistrées dans l’invité peuvent être perdues. Préférez Éteindre si possible. Cible : %1$@ (%2$@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arresto forzato, come staccare la spina: i dati non salvati nel guest possono andare persi. Se possibile, preferisci Spegni. Destinazione: %1$@ (%2$@)."
          }
        }
      }
    },
