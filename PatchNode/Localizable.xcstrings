    },
    "iCloud couldn't be opened: check that you're signed in to iCloud and that iCloud is allowed for PatchNode. Your configuration on this iPhone is used meanwhile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "iCloud konnte nicht geöffnet werden: Prüfe, ob du bei iCloud angemeldet bist und iCloud für PatchNode erlaubt ist. Bis dahin wird die Konfiguration dieses iPhone verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud couldn't be opened: check that you're signed in to iCloud and that iCloud is allowed for PatchNode. Your configuration on this iPhone is used meanwhile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se ha podido abrir iCloud: comprueba que has iniciado sesión en iCloud y que iCloud está permitido para PatchNode. Mientras tanto se usa la configuración de este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir iCloud : vérifiez que vous êtes connecté à iCloud et qu’iCloud est autorisé pour PatchNode. En attendant, la configuration de cet iPhone est utilisée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossibile aprire iCloud: verifica di aver effettuato l’accesso a iCloud e che iCloud sia consentito per PatchNode. Nel frattempo viene usata la configurazione di questo iPhone."
          }
        }
      }
    },
    "iCloud data" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
