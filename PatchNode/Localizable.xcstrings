    "Saving validates the project with docker compose config first, then keeps the previous version as a timestamped .bak file (the 5 latest are kept)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Sichern wird das Projekt zuerst mit docker compose config geprüft, dann bleibt die vorherige Version als .bak-Datei mit Zeitstempel erhalten (die 5 neuesten werden behalten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saving validates the project with docker compose config first, then keeps the previous version as a timestamped .bak file (the 5 latest are kept)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al guardar, primero se valida el proyecto con docker compose config y luego se conserva la versión anterior en un archivo .bak con fecha (se guardan las 5 últimas)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement valide d’abord le projet avec docker compose config, puis garde la version précédente dans un fichier .bak horodaté (les 5 dernières sont gardées)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il salvataggio valida prima il progetto con docker compose config, poi conserva la versione precedente in un file .bak con data e ora (vengono tenute le 5 più recenti)."
          }
        }
      }
    },
