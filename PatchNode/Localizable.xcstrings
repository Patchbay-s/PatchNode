        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erste Verbindung zu %@. Prüfe, dass dieser Fingerabdruck der des Servers ist, bevor du ihm vertraust: Danach lehnt PatchNode jeden anderen Schlüssel für diesen Host ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First connection to %@. Check that this fingerprint is the server's before trusting it: PatchNode will then refuse any other key for this host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Primera conexión a %@. Comprueba que esta huella es la del servidor antes de confiar en ella: después PatchNode rechazará cualquier otra clave para este host."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Première connexion à %@. Vérifiez que cette empreinte est celle du serveur avant de lui faire confiance : PatchNode refusera ensuite toute autre clé pour cet hôte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Prima connessione a %@. Verifica che questa impronta sia quella del server prima di fidarti: poi PatchNode rifiuterà qualsiasi altra chiave per questo host."
          }
        }
      }
    },
