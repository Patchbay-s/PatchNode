        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’importez que vos propres fichiers. Vérifiez chaque adresse : vos jetons y seront envoyés une fois saisis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Importa solo file creati da te. Controlla ogni indirizzo: i tuoi token verranno inviati lì una volta inseriti."
