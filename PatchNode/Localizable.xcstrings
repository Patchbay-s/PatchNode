    "Widgets show the latest data the app saved. iOS decides when background refresh runs; opening the app refreshes them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Widgets zeigen die zuletzt von der App gespeicherten Daten. iOS entscheidet, wann die Hintergrundaktualisierung läuft; das Öffnen der App aktualisiert sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets show the latest data the app saved. iOS decides when background refresh runs; opening the app refreshes them."
