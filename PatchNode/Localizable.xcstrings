    "%@ is paused or its token is missing. Pull to refresh the Proxmox screen, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist pausiert oder sein Token fehlt. Ziehe den Proxmox-Bildschirm zum Aktualisieren und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is paused or its token is missing. Pull to refresh the Proxmox screen, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está en pausa o falta su token. Desliza para actualizar la pantalla de Proxmox y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est en pause ou son jeton manque. Tirez pour rafraîchir l’écran Proxmox, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ è in pausa o manca il suo token. Trascina per aggiornare la schermata Proxmox, poi riprova."
          }
        }
      }
    },
