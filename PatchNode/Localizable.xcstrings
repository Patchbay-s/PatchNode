    "Add this line to ~/.ssh/authorized_keys of the user PatchNode connects as. from= limits the addresses the key is accepted from (your VPN's range); the options forbid port, agent and X11 forwarding." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füge diese Zeile in ~/.ssh/authorized_keys des Benutzers ein, mit dem sich PatchNode verbindet. from= begrenzt die Adressen, von denen der Schlüssel akzeptiert wird (der Bereich deines VPN); die Optionen verbieten Port-, Agent- und X11-Weiterleitung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add this line to ~/.ssh/authorized_keys of the user PatchNode connects as. from= limits the addresses the key is accepted from (your VPN's range); the options forbid port, agent and X11 forwarding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Añade esta línea al ~/.ssh/authorized_keys del usuario con el que se conecta PatchNode. from= limita las direcciones desde las que se acepta la clave (el rango de tu VPN); las opciones prohíben el reenvío de puertos, de agente y X11."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez cette ligne au ~/.ssh/authorized_keys de l’utilisateur avec lequel PatchNode se connecte. from= limite les adresses d’où la clé est acceptée (la plage de votre VPN) ; les options interdisent le transfert de ports, d’agent et X11."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aggiungi questa riga al ~/.ssh/authorized_keys dell’utente con cui si connette PatchNode. from= limita gli indirizzi da cui la chiave è accettata (l’intervallo della tua VPN); le opzioni vietano l’inoltro di porte, agente e X11."
          }
        }
      }
    },
