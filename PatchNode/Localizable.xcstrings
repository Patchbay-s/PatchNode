    "The configuration synced in your iCloud will be deleted. This iPhone keeps its configuration. Sync is turned off." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die in deiner iCloud synchronisierte Konfiguration wird gelöscht. Dieses iPhone behält seine Konfiguration. Die Synchronisierung wird ausgeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The configuration synced in your iCloud will be deleted. This iPhone keeps its configuration. Sync is turned off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se eliminará la configuración sincronizada en tu iCloud. Este iPhone conserva su configuración. La sincronización se desactiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration synchronisée dans votre iCloud sera supprimée. Cet iPhone garde sa configuration. La synchronisation est désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configurazione sincronizzata nel tuo iCloud sarà eliminata. Questo iPhone conserva la sua configurazione. La sincronizzazione viene disattivata."
          }
        }
      }
    },
    "The configuration synced in your iCloud, and your tokens in iCloud Keychain, will be deleted from iCloud and your other devices. This iPhone keeps its configuration and its tokens. Sync is turned off." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die in deiner iCloud synchronisierte Konfiguration und deine Tokens im iCloud-Schlüsselbund werden aus iCloud und von deinen anderen Geräten gelöscht. Dieses iPhone behält seine Konfiguration und seine Tokens. Die Synchronisierung wird ausgeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The configuration synced in your iCloud, and your tokens in iCloud Keychain, will be deleted from iCloud and your other devices. This iPhone keeps its configuration and its tokens. Sync is turned off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configuración sincronizada en tu iCloud y tus tokens del Llavero de iCloud se eliminarán de iCloud y de tus otros dispositivos. Este iPhone conserva su configuración y sus tokens. La sincronización se desactiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration synchronisée dans votre iCloud et vos jetons du trousseau iCloud seront supprimés d’iCloud et de vos autres appareils. Cet iPhone garde sa configuration et ses jetons. La synchronisation est désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configurazione sincronizzata nel tuo iCloud e i tuoi token nel Portachiavi iCloud saranno eliminati da iCloud e dagli altri tuoi dispositivi. Questo iPhone conserva la sua configurazione e i suoi token. La sincronizzazione viene disattivata."
          }
        }
      }
    },
